# MQTT 브로커 WebSocket 주소 (Mosquitto websockets 리스너)
VITE_MQTT_URL=ws://localhost:9001
# 브로커 인증이 있으면 채운다 (예: HiveMQ Cloud는 wss://<host>:8884/mqtt + 계정)
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# 텔레메트리 발행 토픽: devices/<token>/telemetry (iot-monitoring-control에 등록한 기기 토큰)
VITE_DEVICE_TOKEN=sim-usv-1
# 명령 구독 토픽: devices/<id>/commands (기기 ID)
VITE_DEVICE_ID=1

# 텔레메트리 발행 주기 (ms)
VITE_TELEMETRY_INTERVAL_MS=2000

# 시뮬레이션 시작 위치 (기본: 부산 앞바다)
VITE_INITIAL_LAT=35.05
VITE_INITIAL_LON=129.08
