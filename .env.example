# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요:
#   cp .env.example .env.local
# 아무 값도 안 채워도 실행됩니다(절차적 바다 + 오프라인). 아래는 전부 선택 항목.
# ─────────────────────────────────────────────────────────────

# ── 위성 지도 / 실제 지형 (선택, 그러나 권장) ────────────────
# VWorld(브이월드) 오픈 API 인증키.
#   있으면 → 위성 지도 + 실제 지형(대청호)으로 실행
#   없으면 → 절차적 파도 바다로 실행
# 발급: https://www.vworld.kr  →  오픈API > 인증키 발급
#   · 서비스: "데이터 API" 또는 WMTS 지도, 유형: 웹사이트
#   · 도메인에 http://localhost:5173 (개발) / 배포 도메인 등록
VITE_VWORLD_KEY=

# ── MQTT 브로커 접속 (선택) ──────────────────────────────────
# 브로커가 없어도 시뮬레이터는 동작합니다(HUD에 "연결 끊김" 표시).
# 방법 1) 조각으로 설정 (권장)
VITE_MQTT_PROTOCOL=ws        # ws | wss
VITE_MQTT_HOST=localhost
VITE_MQTT_PORT=9001
# VITE_MQTT_PATH=/           # HiveMQ Cloud 등은 /mqtt 필요

# 방법 2) 전체 URL 직접 지정 (설정 시 방법 1보다 우선)
# VITE_MQTT_URL=wss://<host>:8884/mqtt

# 브로커 계정 — iot-monitoring-control 로컬 브로커는 device 계정 사용
VITE_MQTT_USERNAME=device
VITE_MQTT_PASSWORD=

# ── 기기 식별 (MQTT 토픽) ────────────────────────────────────
# 텔레메트리 발행 토픽: devices/<token>/telemetry (플랫폼에 등록한 기기 토큰)
VITE_DEVICE_TOKEN=sim-usv-1
# 명령 구독 토픽: devices/<id>/commands (기기 ID)
VITE_DEVICE_ID=1

# ── 시뮬레이션 ───────────────────────────────────────────────
# 텔레메트리 발행 주기 (ms)
VITE_TELEMETRY_INTERVAL_MS=2000
# 시작 위치 (기본: 대청호 — 위성/지형 데이터가 이 일대에 맞춰져 있음)
VITE_INITIAL_LAT=36.47655
VITE_INITIAL_LON=127.48375
