# ── MQTT 브로커 접속 ─────────────────────────────────
# 방법 1) 조각으로 설정 (권장)
VITE_MQTT_PROTOCOL=ws        # ws | wss
VITE_MQTT_HOST=localhost
VITE_MQTT_PORT=9001
# VITE_MQTT_PATH=/           # HiveMQ Cloud 등은 /mqtt 필요

# 방법 2) 전체 URL 직접 지정 (설정 시 방법 1보다 우선)
# VITE_MQTT_URL=wss://<host>:8884/mqtt

# 브로커 계정 — iot-monitoring-control 로컬 브로커는 device 계정 사용
# (mosquitto/setup-users.sh 실행 시 정한 비밀번호)
VITE_MQTT_USERNAME=device
VITE_MQTT_PASSWORD=

# ── 기기 식별 ────────────────────────────────────────
# 텔레메트리 발행 토픽: devices/<token>/telemetry (플랫폼에 등록한 기기 토큰)
VITE_DEVICE_TOKEN=sim-usv-1
# 명령 구독 토픽: devices/<id>/commands (기기 ID)
VITE_DEVICE_ID=1

# ── 시뮬레이션 ───────────────────────────────────────
# 텔레메트리 발행 주기 (ms)
VITE_TELEMETRY_INTERVAL_MS=2000
# 시작 위치 (기본: 부산 앞바다)
VITE_INITIAL_LAT=35.05
VITE_INITIAL_LON=129.08
