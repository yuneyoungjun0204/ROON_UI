# ─── USV Simulator 환경변수 ────────────────────────────────
# .env.local 로 복사해 값을 채우세요 (다 비워도 실행됨).
#   cp .env.example .env.local
# 로컬/배포는 아래에서 한 블록만 주석 해제해 전환합니다.

# 위성 지도·지형 (없으면 절차적 바다). https://www.vworld.kr → 인증키(웹사이트, localhost:5173)
VITE_VWORLD_KEY=

# MQTT 계정
VITE_MQTT_USERNAME=device
VITE_MQTT_PASSWORD=

# 시뮬레이션
VITE_TELEMETRY_INTERVAL_MS=1000
VITE_INITIAL_LAT=36.47655       # 대청호
VITE_INITIAL_LON=127.48375

# ── [로컬] 로컬 iot 스택 (docker-compose.local: MQTT 9001 / API 8001) ──
VITE_MQTT_HOST=localhost
VITE_HTTP_API_BASE=http://localhost:8001
VITE_DEVICE_TOKEN=<로컬 기기 토큰>
VITE_DEVICE_ID=<로컬 기기 ID>

# ── [배포] wss/https (예: inspirit-dev.cloud) — 위 로컬 블록 대신 사용 ──
# 페이지를 https로 열면 브라우저가 ws/http를 차단하므로 wss·https 필수.
#VITE_MQTT_URL=wss://mqtt-ws.<도메인>
#VITE_HTTP_API_BASE=https://api.<도메인>
#VITE_DEVICE_TOKEN=<배포 기기 토큰>
#VITE_DEVICE_ID=<배포 기기 ID>

# ── 카메라 (기본 켜짐 · fpv·cctv 2대를 VITE_HTTP_API_BASE 로 전송) ──
#VITE_CAMERA_ENABLED=false      # 카메라 끄기
#VITE_CAMERA_QUALITY=0.6        # JPEG 품질 0~1
